# Deploy API Environment Variables
# Copy this file to .env and fill in your values

# Required: API key for authentication
DEPLOY_API_KEY=your-secure-api-key-here

# Optional: Cloudflare AI for LLM analysis
# Get your API key from: https://dash.cloudflare.com/profile/api-tokens
CF_API_KEY=your-cloudflare-api-key
CF_ACCOUNT_ID=your-cloudflare-account-id

# Optional: Google Gemini for LLM analysis
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key

# Optional: LLM type configuration
# Options: "cloudflare", "ollama", or leave empty to disable
LLM_TYPE=cloudflare

# Optional: Ollama configuration (for local/remote Ollama)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_HOST=http://your-ollama-server:11434

# Optional: Custom model selection
# LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Optional: Argo CD API, refresh/sync the Application right after a push.
# Feature is off when either is empty.
# ARGOCD_API_URL=http://argocd-server.argocd.svc
# ARGOCD_API_TOKEN=your-argocd-account-token

# Optional: Repository URLs (for production)
# ARGOCD_STAGING_URL=git@github.com:org/k8s-staging.git
# ARGOCD_PROD_URL=git@github.com:org/k8s-prod.git
# APP_CORE_API_URL=git@github.com:org/core-api.git
